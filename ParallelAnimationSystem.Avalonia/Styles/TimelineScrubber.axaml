<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ParallelAnimationSystem.Avalonia.Controls">

    <Style Selector="controls|TimelineScrubber">
        <Style.Resources>
            <controls:NormalizedToWidthConverter x:Key="NormalizedToWidthConverter" />
            <controls:NormalizedToLeftConverter x:Key="NormalizedToThumbMarginConverter" />
        </Style.Resources>
        
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />

        <Setter Property="Template">
            <ControlTemplate>
                <Panel Height="20"
                       Background="Transparent"
                       Margin="7,0"
                       x:Name="PART_Track">
                    <Border Height="6"
                            CornerRadius="2"
                            Background="#0FE0E0E0"
                            IsHitTestVisible="False">
                        <Border x:Name="FillBar"
                                CornerRadius="2"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource PrimaryColor}">
                            <Border.Width>
                                <MultiBinding Converter="{StaticResource NormalizedToWidthConverter}">
                                    <TemplateBinding Property="Value" />
                                    <TemplateBinding Property="Minimum" />
                                    <TemplateBinding Property="Maximum" />
                                    <Binding ElementName="PART_Track" Path="Bounds.Width" />
                                </MultiBinding>
                            </Border.Width>
                        </Border>
                    </Border>
                    
                    <Canvas Width="0"
                            Height="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                        <Border x:Name="PART_Thumb"
                                Width="14" Height="14"
                                Canvas.Top="-7"
                                Background="{DynamicResource PrimaryColor}"
                                CornerRadius="7">
                            <Canvas.Left>
                                <MultiBinding Converter="{StaticResource NormalizedToThumbMarginConverter}">
                                    <TemplateBinding Property="Value" />
                                    <TemplateBinding Property="Minimum" />
                                    <TemplateBinding Property="Maximum" />
                                    <Binding ElementName="PART_Track" Path="Bounds.Width" />
                                </MultiBinding>
                            </Canvas.Left>
    
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Height" Duration="0:0:0.1" />
                                    <DoubleTransition Property="(Canvas.Top)" Duration="0:0:0.1" />
                                </Transitions>
                            </Border.Transitions>
                        </Border>
                    </Canvas>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    
    <Style Selector="controls|TimelineScrubber:hovering /template/ Border#PART_Thumb">
        <Setter Property="Height" Value="20" />
        <Setter Property="(Canvas.Top)" Value="-10" />
    </Style>
</Styles>
