<shadui:Window xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:vm="using:ParallelAnimationSystem.Avalonia.ViewModels"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:integration="clr-namespace:ParallelAnimationSystem.Avalonia.Integration"
               xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
               SaveWindowState="True"
               TitleFontWeight="SemiBold"
               Width="1024"
               WindowStartupLocation="CenterScreen"
               EnableTrafficLightPositioning="True"
               TrafficLightOffset="5,8"
               mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
               x:Class="ParallelAnimationSystem.Avalonia.Views.MainWindow"
               x:DataType="vm:MainWindowViewModel"
               Icon="/Assets/avalonia-logo.ico"
               Title="Parallel Animation System">
    
    <shadui:Window.RightWindowTitleBarContent>
        <Button
            Background="{DynamicResource SidebarBackgroundColor}"
            CornerRadius="{DynamicResource MdCornerRadius}"
            Command="{Binding OpenBeatmapCommand}"
            CommandParameter="{Binding $parent[shadui:Window]}"
            Height="30"
            Width="30"
            ToolTip.Tip="Open Beatmap">
            <LucideIcon Kind="FolderOpen" 
                        Size="20" />
        </Button>
    </shadui:Window.RightWindowTitleBarContent>
    
    <Grid RowDefinitions="*,Auto" Margin="12" ColumnSpacing="12" RowSpacing="12" ClipToBounds="True">
        <Border Grid.Row="0" 
                CornerRadius="12" 
                BorderThickness="1"
                Background="{DynamicResource CardBackgroundColor}"
                BorderBrush="{DynamicResource BorderColor}">
            <Border CornerRadius="13"
                    ClipToBounds="True">
                <integration:PASControl x:Name="PasControl"
                                        Time="{Binding Time}"
                                        TickCommand="{Binding TickCommand}" />
            </Border>
        </Border>
        
        <shadui:Card Grid.Row="1">
            <StackPanel Spacing="4">
                <!-- Seek slider -->
                <Slider Minimum="0"
                        Maximum="{Binding AudioPlayer, Converter={x:Static vm:MainWindowViewModel.AudioPlayerToDurationConverter}}"
                        Value="{Binding SeekPosition}" />

                <!-- Controls row -->
                <Grid ColumnDefinitions="*,Auto,*" Height="36">
                    <!-- Current time -->
                    <TextBlock Grid.Column="0"
                               Text="{Binding Time, Converter={x:Static vm:MainWindowViewModel.TimeToCurrentTimeTextConverter}}"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{DynamicResource ForegroundLeadColor}" />
                    
                    <Button Grid.Column="1"
                            Classes="Icon" 
                            Command="{Binding PlayPauseCommand}"
                            Width="36" Height="36"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Play / Pause">
                        <LucideIcon Kind="{Binding IsPlaying, Converter={x:Static vm:MainWindowViewModel.PlayingToPlayPauseIconConverter}}" />
                    </Button>

                    <!-- Total duration -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding AudioPlayer, Converter={x:Static vm:MainWindowViewModel.AudioPlayerToDurationTextConverter}}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{DynamicResource ForegroundLeadColor}" />
                </Grid>
            </StackPanel>
        </shadui:Card>
    </Grid>
</shadui:Window>
