<shadui:Window xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:vm="using:ParallelAnimationSystem.Avalonia.ViewModels"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:integration="clr-namespace:ParallelAnimationSystem.Avalonia.Integration"
               xmlns:shadui="clr-namespace:ShadUI;assembly=ShadUI"
               xmlns:control="clr-namespace:ParallelAnimationSystem.Avalonia.Controls"
               SaveWindowState="True"
               TitleFontWeight="SemiBold"
               Width="1024"
               WindowStartupLocation="CenterScreen"
               EnableTrafficLightPositioning="True"
               TrafficLightOffset="5,8"
               mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
               x:Class="ParallelAnimationSystem.Avalonia.Views.MainWindow"
               x:DataType="vm:MainWindowViewModel"
               Icon="/Assets/icon.ico"
               Title="Parallel Animation System">
    <shadui:Window.RightWindowTitleBarContent>
        <StackPanel Orientation="Horizontal" 
                    FlowDirection="RightToLeft"
                    Spacing="8">
            <Button Background="{DynamicResource SidebarBackgroundColor}"
                    CornerRadius="{DynamicResource MdCornerRadius}"
                    Command="{Binding OpenBeatmapCommand}"
                    CommandParameter="{Binding $parent[shadui:Window]}"
                    Height="30"
                    Width="30"
                    ToolTip.Tip="Open Beatmap"
                    Content="{LucideIconContent FolderOpen, Size=20}"
                    VerticalAlignment="Center"/>
            <TextBlock FontWeight="Bold"
                       VerticalAlignment="Center"
                       TextAlignment="Right"
                       HorizontalAlignment="Right"
                       FlowDirection="LeftToRight"
                       Text="{Binding Fps, Converter={x:Static vm:MainWindowViewModel.FpsTextConverter}}"/>
        </StackPanel>
    </shadui:Window.RightWindowTitleBarContent>
    
    <Grid RowDefinitions="*,Auto" 
          Margin="12" 
          ColumnSpacing="12" 
          RowSpacing="12" 
          ClipToBounds="True">
        <control:AspectRatioPanel Grid.Row="0" >
            <Border CornerRadius="12" 
                    BorderThickness="1"
                    Background="{DynamicResource CardBackgroundColor}"
                    BorderBrush="{DynamicResource BorderColor}">
                <Border CornerRadius="13"
                        ClipToBounds="True">
                    <ContentControl Content="{Binding PASViewModel}"/>
                </Border>
            </Border>
        </control:AspectRatioPanel>
        
        <shadui:Card Grid.Row="1">
            <StackPanel Spacing="4">
                <control:TimelineScrubber Minimum="0"
                                          Maximum="{Binding AudioPlayer, Converter={x:Static vm:MainWindowViewModel.AudioPlayerToDurationConverter}}"
                                          Value="{Binding ScrubberPosition}"
                                          SeekRequested="TimelineScrubber_OnSeekRequested" />
                
                <Grid ColumnDefinitions="*,Auto,*" Height="36">
                    <TextBlock Grid.Column="0"
                               Text="{Binding ScrubberPosition, Converter={x:Static vm:MainWindowViewModel.TimeToCurrentTimeTextConverter}}"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{DynamicResource ForegroundLeadColor}" />
                    <Button Grid.Column="1"
                            Classes="Icon" 
                            Command="{Binding PlayPauseCommand}"
                            Width="36" Height="36"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            ToolTip.Tip="Play / Pause">
                        <LucideIcon Kind="{Binding IsPlaying, Converter={x:Static vm:MainWindowViewModel.PlayingToPlayPauseIconConverter}}" />
                    </Button>
                    <TextBlock Grid.Column="2"
                               Text="{Binding AudioPlayer, Converter={x:Static vm:MainWindowViewModel.AudioPlayerToDurationTextConverter}}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{DynamicResource ForegroundLeadColor}" />
                </Grid>
            </StackPanel>
        </shadui:Card>
    </Grid>
</shadui:Window>
